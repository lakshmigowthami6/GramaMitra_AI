# GramaMitra AI - Backend Environment Configuration

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=gramamitra-dev-secret-key-change-in-production
PORT=5000

# Database Configuration (SQLite by default, compatible with PostgreSQL)
DATABASE_URL=sqlite:///gramamitra.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Google Gemini API Key (optional for testing, required for live LLM responses; factual fallback activates if absent)
GEMINI_API_KEY=your_gemini_api_key_here
